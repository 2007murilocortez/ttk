{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/app/config.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ],
  "redirects": [
    { "source": "/", "destination": "/app/", "permanent": false },
    { "source": "/app/up1", "destination": "/app/", "permanent": false },
    { "source": "/app/up1/:path*", "destination": "/app/", "permanent": false },
    { "source": "/app/up2", "destination": "/app/", "permanent": false },
    { "source": "/app/up2/:path*", "destination": "/app/", "permanent": false },
    { "source": "/app/up3", "destination": "/app/", "permanent": false },
    { "source": "/app/up3/:path*", "destination": "/app/", "permanent": false },
    { "source": "/app/downsell", "destination": "/app/", "permanent": false },
    { "source": "/app/downsell/:path*", "destination": "/app/", "permanent": false },
    { "source": "/app/parcours", "destination": "/app/", "permanent": false },
    { "source": "/app/parcours/:path*", "destination": "/app/", "permanent": false },
    { "source": "/app/commande-indisponible", "destination": "/app/", "permanent": false },
    { "source": "/app/commande-indisponible/:path*", "destination": "/app/", "permanent": false }
  ]
}
