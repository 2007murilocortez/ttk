{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "query", "key": "to" }],
      "destination": "/checkout/",
      "permanent": false
    },
    {
      "source": "/",
      "missing": [{ "type": "query", "key": "to" }],
      "destination": "/pv11/",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/pv11", "destination": "/pv11/index.html" },
    { "source": "/pv11/trading", "destination": "/pv11/trading/index.html" },
    { "source": "/pv11/vsl", "destination": "/pv11/vsl/index.html" },
    { "source": "/pv11/withdraw", "destination": "/pv11/withdraw/index.html" },
    { "source": "/back", "destination": "/back/index.html" },
    { "source": "/checkout", "destination": "/checkout/index.html" }
  ],
  "headers": [
    {
      "source": "/static-nav.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/checkout.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
